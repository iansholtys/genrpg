PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# OIDC discovery document URL, for example:
# https://auth.example.com/application/o/genrpg/.well-known/openid-configuration
OIDC_CONFIGURATION_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Optional when APP_BASE_URL is not enough or the provider requires an exact URI.
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated emails that should be promoted to GenRPG admins at login.
ADMIN_EMAILS=

# Either set DATABASE_URL or the PG* variables below.
DATABASE_URL=postgres://genrpg:genrpg@postgres:5432/genrpg
# PGHOST=postgres
# PGPORT=5432
# PGDATABASE=genrpg
# PGUSER=genrpg
# PGPASSWORD=genrpg
# PGSSL=false

# Set true when terminating TLS before the app and serving over HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=loopback
